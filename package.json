  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.54.1",
    "@types/node": "24.1.0",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4",
    "vite": "7.0.6"
  }
